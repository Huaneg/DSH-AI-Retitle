{
  "name": "dsh-ai-retitle",
  "version": "1.0.0",
  "description": "Rename a DeepSeek Harness conversation from its current content: a sidebar button, a /retitle command, and a retitle_conversation tool.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Huaneg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Huaneg/DSH-AI-Retitle.git"
  },
  "homepage": "https://github.com/Huaneg/DSH-AI-Retitle#readme",
  "bugs": {
    "url": "https://github.com/Huaneg/DSH-AI-Retitle/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "session-title"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
